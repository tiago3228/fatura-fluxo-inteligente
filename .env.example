# Variáveis públicas usadas pelo cliente Supabase.
# Preencha no ambiente de desenvolvimento/produção; nunca commite valores reais.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SSO server-side para o CEU Finanças. Nunca use essas variáveis no cliente.
CEU_SUPABASE_URL=
CEU_SUPABASE_SERVICE_ROLE_KEY=
